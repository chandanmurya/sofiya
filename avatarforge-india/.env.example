# ============================================
# AvatarForge India - Environment Variables
# ============================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/avatarforge?schema=public"

# Auth (NextAuth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# HeyGen API
HEYGEN_API_KEY=your-heygen-api-key
HEYGEN_WEBHOOK_SECRET=your-heygen-webhook-secret
HEYGEN_CALLBACK_URL=https://yourdomain.com/api/webhooks/heygen

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=avatarforge-uploads
R2_PUBLIC_URL=https://your-r2-public-url.com

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Razorpay Subscription Plan IDs (create these in Razorpay Dashboard)
RAZORPAY_PLAN_STARTER=plan_xxxxx
RAZORPAY_PLAN_CREATOR=plan_xxxxx
RAZORPAY_PLAN_STUDIO=plan_xxxxx

# ─── Billing / Profitability Config (all overridable) ─────────
# Exchange rate
BILLING_USDINR=96

# HeyGen per-minute costs (USD)
BILLING_HEYGEN_720P_USD=1.00
BILLING_HEYGEN_1080P_USD=1.00
BILLING_HEYGEN_4K_USD=1.20

# Buffer multiplier for retries/edge cases
BILLING_HEYGEN_BUFFER=1.15

# Payment fee rate (Razorpay + GST + subscription fee)
BILLING_PAYMENT_FEE_RATE=0.05

# Infra cost per minute (INR)
BILLING_INFRA_PER_MIN_INR=5

# Target gross margin (minimum)
BILLING_TARGET_MARGIN=0.30

# Avatar setup cost (HeyGen training cost USD)
BILLING_AVATAR_COST_USD=5.00

# Fixed ops fee per avatar (INR)
BILLING_AVATAR_OPS_FEE_INR=50

# Top-up expiry (days)
BILLING_TOPUP_EXPIRY_DAYS=60

# Sentry (optional)
SENTRY_DSN=

# Admin
ADMIN_EMAILS=admin@avatarforge.in
