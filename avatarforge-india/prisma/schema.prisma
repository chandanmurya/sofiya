// ============================================
// AvatarForge India - Database Schema v2
// ============================================
// Updated: Strict profitability billing model
// 1 credit = 1 second of video output
// Separate credit_wallet, usage_ledger, events_dedup, add_ons

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth Models ─────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── User Model ──────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?
  role          UserRole  @default(USER)
  locale        String    @default("en")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  avatars       Avatar[]
  voices        VoiceClone[]
  videos        Video[]
  subscription  Subscription?
  creditWallet  CreditWallet?
  usageLedger   UsageLedger[]
  jobs          Job[]
  addOns        AddOn[]
  topups        TopupPurchase[]

  @@index([email])
}

enum UserRole {
  USER
  ADMIN
}

// ─── Avatar Model ────────────────────────────────────────────

model Avatar {
  id              String       @id @default(cuid())
  userId          String
  name            String
  status          AvatarStatus @default(PENDING_UPLOAD)

  // Training video
  trainingVideoUrl   String?
  trainingVideoKey   String?
  trainingDurationSec Int?

  // HeyGen integration
  heygenAvatarId     String?  @unique
  heygenGroupId      String?
  consentUrl         String?
  consentStatus      ConsentStatus @default(PENDING)
  consentCompletedAt DateTime?

  // Metadata
  thumbnailUrl    String?
  errorMessage    String?
  retryCount      Int      @default(0)
  idempotencyKey  String   @unique @default(cuid())
  rawResponse     Json?    // Store HeyGen raw response for debugging
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos Video[]
  addOn  AddOn?  @relation("AvatarAddOn") // linked to add-on purchase

  @@index([userId])
  @@index([heygenAvatarId])
  @@index([status])
}

enum AvatarStatus {
  PENDING_UPLOAD
  UPLOADING
  UPLOADED
  CONSENT_REQUIRED
  CONSENT_PENDING
  TRAINING
  TRAINING_FAILED
  READY
  FAILED
}

enum ConsentStatus {
  PENDING
  SENT
  COMPLETED
  FAILED
}

// ─── Voice Clone Model ───────────────────────────────────────

model VoiceClone {
  id            String     @id @default(cuid())
  userId        String
  name          String
  status        VoiceStatus @default(PENDING_UPLOAD)

  // Audio source
  audioUrl      String?
  audioKey      String?
  audioDurationSec Int?
  sourceType    VoiceSourceType @default(DEDICATED_AUDIO)

  // HeyGen integration
  heygenVoiceId String?   @unique

  // Metadata
  language      String    @default("en")
  errorMessage  String?
  retryCount    Int       @default(0)
  idempotencyKey String   @unique @default(cuid())
  rawResponse   Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos Video[]

  @@index([userId])
  @@index([heygenVoiceId])
}

enum VoiceStatus {
  PENDING_UPLOAD
  UPLOADING
  UPLOADED
  CLONING
  CLONE_FAILED
  READY
  FAILED
}

enum VoiceSourceType {
  DEDICATED_AUDIO
  EXTRACTED_FROM_VIDEO
}

// ─── Video Model ─────────────────────────────────────────────

model Video {
  id             String      @id @default(cuid())
  userId         String
  avatarId       String
  voiceId        String
  title          String
  status         VideoStatus @default(DRAFT)

  // Script
  script         String      @db.Text
  scriptLanguage String      @default("en")

  // Video config
  aspectRatio    AspectRatio @default(LANDSCAPE_16_9)
  resolution     Resolution  @default(HD_720P)
  backgroundColor String?    @default("#000000")
  backgroundImageUrl String?
  transparentBg  Boolean     @default(false)

  // HeyGen integration
  heygenVideoId  String?    @unique

  // Output
  outputUrl      String?
  outputKey      String?
  durationSec    Int?       // actual output duration
  fileSizeMb     Float?

  // Cost tracking (seconds-based)
  secondsUsed    Int        @default(0)  // actual seconds consumed from wallet
  costEstimateInr Float?

  // Template
  templateId     String?

  // Metadata
  errorMessage   String?
  retryCount     Int        @default(0)
  idempotencyKey String     @unique @default(cuid())
  rawResponse    Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  completedAt    DateTime?

  // Relations
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar  Avatar     @relation(fields: [avatarId], references: [id])
  voice   VoiceClone @relation(fields: [voiceId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([heygenVideoId])
  @@index([createdAt])
}

enum VideoStatus {
  DRAFT
  QUEUED
  GENERATING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum AspectRatio {
  PORTRAIT_9_16
  LANDSCAPE_16_9
  SQUARE_1_1
}

enum Resolution {
  SD_480P
  HD_720P
  FHD_1080P
  UHD_4K
}

// ─── Job Queue Model ─────────────────────────────────────────

model Job {
  id             String    @id @default(cuid())
  userId         String
  type           JobType
  status         JobStatus @default(PENDING)

  entityId       String
  entityType     EntityType

  bullmqJobId    String?

  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  lastError      String?   @db.Text
  idempotencyKey String    @unique

  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([entityId, entityType])
}

enum JobType {
  AVATAR_TRAINING
  VOICE_CLONING
  VIDEO_GENERATION
  VIDEO_DOWNLOAD
}

enum JobStatus {
  PENDING
  PROCESSING
  WAITING_CALLBACK
  COMPLETED
  FAILED
  CANCELLED
}

enum EntityType {
  AVATAR
  VOICE
  VIDEO
}

// ═══════════════════════════════════════════════════════════════
// BILLING v2: Strict Profitability Model
// ═══════════════════════════════════════════════════════════════

// ─── Subscription ────────────────────────────────────────────

model Subscription {
  id                  String             @id @default(cuid())
  userId              String             @unique
  plan                PlanType           @default(STARTER)
  status              SubscriptionStatus @default(CREATED)

  // Razorpay integration
  razorpaySubId       String?            @unique
  razorpayPlanId      String?
  razorpayCustomerId  String?

  // Billing cycle
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  cancelledAt         DateTime?

  // Plan snapshot (computed from profitability engine at subscription time)
  monthlyIncludedSeconds Int             @default(60)
  maxResolution          String          @default("720p")
  priorityQueue          Boolean         @default(false)

  // Grace period handling
  gracePeriodEnd      DateTime?          // 3 days after payment failure

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([razorpaySubId])
  @@index([status])
}

enum PlanType {
  STARTER
  CREATOR
  STUDIO
}

enum SubscriptionStatus {
  CREATED     // subscription created but not yet activated
  ACTIVE
  GRACE       // payment failed, 3-day grace period
  PAST_DUE    // grace expired, blocked
  CANCELLED   // user cancelled (active until period end)
  INACTIVE    // fully cancelled/expired
  PAUSED
}

// ─── Credit Wallet ───────────────────────────────────────────
// 1 credit = 1 second of video output

model CreditWallet {
  id                    String   @id @default(cuid())
  userId                String   @unique

  // Monthly included seconds (reset each billing cycle)
  monthlyIncludedSeconds Int     @default(60)
  monthlyRemaining       Int     @default(60)   // decremented on use
  monthlyResetAt         DateTime @default(now())

  // Top-up seconds (purchased separately, expire per TOPUP_EXPIRY_DAYS)
  topupSeconds           Int     @default(0)

  // Lifetime counters
  totalSecondsEarned     Int     @default(0)
  totalSecondsSpent      Int     @default(0)

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Usage Ledger ────────────────────────────────────────────
// Every second consumed is logged here for audit + billing reconciliation

model UsageLedger {
  id              String    @id @default(cuid())
  userId          String
  jobId           String?   // optional: linked video/job
  videoId         String?   // direct video reference

  secondsUsed     Int       // ceil(actual_video_seconds)
  source          CreditSource // which bucket was consumed
  costEstimateInr Float     // estimated cost to us in INR

  description     String?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([videoId])
}

enum CreditSource {
  MONTHLY    // from monthlyRemaining
  TOPUP      // from topupSeconds
}

// ─── Events Dedup (Webhook Idempotency) ──────────────────────
// Ensures each webhook event is processed exactly once

model EventDedup {
  id        String   @id @default(cuid())
  provider  String   // 'razorpay' | 'heygen'
  eventId   String   // razorpay event_id or heygen callback_id

  processed Boolean  @default(false)
  payload   Json?
  createdAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([provider, eventId])
}

// ─── Add-Ons (Avatar Setup) ──────────────────────────────────

model AddOn {
  id                String    @id @default(cuid())
  userId            String
  type              AddOnType
  status            AddOnStatus @default(PENDING_PAYMENT)

  // Pricing (snapshot at purchase time)
  priceInr          Int       // customer price in paise (INR * 100)
  costInr           Int       // our cost in paise

  // Razorpay payment
  razorpayOrderId   String?   @unique
  razorpayPaymentId String?   @unique

  // Linked entity
  avatarId          String?   @unique // for AVATAR_SETUP type

  createdAt         DateTime  @default(now())
  completedAt       DateTime?

  // Relations
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar Avatar? @relation("AvatarAddOn", fields: [avatarId], references: [id])

  @@index([userId])
  @@index([type, status])
}

enum AddOnType {
  AVATAR_SETUP
}

enum AddOnStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

// ─── Top-up Purchases ────────────────────────────────────────

model TopupPurchase {
  id                String       @id @default(cuid())
  userId            String

  seconds           Int          // seconds purchased
  priceInr          Int          // in paise (INR * 100)

  // Razorpay payment
  razorpayOrderId   String?      @unique
  razorpayPaymentId String?      @unique

  status            TopupStatus  @default(PENDING_PAYMENT)
  expiresAt         DateTime?    // topups expire after N days

  createdAt         DateTime     @default(now())
  paidAt            DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

enum TopupStatus {
  PENDING_PAYMENT
  PAID
  EXPIRED
  REFUNDED
}

// ─── Invoices ────────────────────────────────────────────────

model Invoice {
  id                 String        @id @default(cuid())
  subscriptionId     String
  razorpayInvoiceId  String?       @unique
  razorpayPaymentId  String?

  amount             Int           // in paise (INR * 100)
  currency           String        @default("INR")
  status             InvoiceStatus @default(PENDING)

  paidAt             DateTime?
  createdAt          DateTime      @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@index([razorpayPaymentId])
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ─── Templates ───────────────────────────────────────────────

model ScriptTemplate {
  id          String   @id @default(cuid())
  name        String
  nameHi      String?
  category    String
  language    String
  script      String   @db.Text
  aspectRatio AspectRatio @default(PORTRAIT_9_16)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([language])
}

// ─── Webhook Logs (General Audit) ────────────────────────────

model WebhookLog {
  id          String   @id @default(cuid())
  source      String
  eventType   String
  payload     Json
  status      String   @default("received")
  errorMessage String?
  processedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([source, eventType])
  @@index([createdAt])
}
